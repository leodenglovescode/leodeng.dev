{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "leodeng-daily-ai-traffic",
  "account_id": "d2a4af1f1770a0f86f8063035515a56c",
  "main": "index.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01
  },
  "ratelimits": [
    {
      "name": "PER_IP",
      "namespace_id": "2026102201",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "OVERALL",
      "namespace_id": "2026102202",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_HUB",
        "class_name": "LiveHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-live-hub",
      "new_sqlite_classes": [
        "LiveHub"
      ]
    }
  ]
}
