[Unit]
Description=Stream fixed site questions through an outbound private Ollama relay
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=5
DynamicUser=yes
EnvironmentFile=/etc/daily-ai.env
ExecStart=/usr/bin/python3 /usr/local/lib/daily-ai/daily_ai_live.py
ExecStopPost=/usr/bin/python3 /usr/local/lib/daily-ai/daily_ai.py --unload
StateDirectory=daily-ai
TimeoutStartSec=30
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
