# Install as /etc/daily-ai.env, root-owned, mode 600. Never commit real values.
DAILY_AI_SITE=https://leodeng.dev
DAILY_AI_TOKEN=replace-with-a-separate-random-publishing-secret
DAILY_AI_OLLAMA=http://127.0.0.1:11434
# Installed Q4_K_M model; nothing downloads automatically.
DAILY_AI_MODEL=qwen3.8:27b
# Partial GPU offload leaves VRAM for other applications. Remaining layers use RAM/CPU.
DAILY_AI_GPU_LAYERS=40
