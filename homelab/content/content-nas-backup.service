[Unit]
Description=Back up website Markdown and shelf to NAS over explicit FTPS
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=12h
StartLimitBurst=3
[Service]
Type=oneshot
ExecStart=/usr/local/bin/leodeng-content-nas-backup
TimeoutStartSec=15min
TimeoutStopSec=60s
Restart=on-failure
RestartSec=1h
RuntimeDirectory=leodeng-content-nas
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/leodeng-content /run/lock
