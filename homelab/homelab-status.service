[Unit]
Description=Push a homelab heartbeat and LLM token rollup to leodeng.dev
# Don't fire before the box can actually resolve and reach the internet;
# otherwise every boot logs a failed push.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# HOMELAB_TOKEN lives here, not in the unit file — unit files are world-readable
# by default and this one is committed to a public repo. systemd reads this as
# root before dropping to User=, so it can stay root-owned and mode 600.
EnvironmentFile=/etc/homelab-status.env
ExecStart=/usr/local/bin/homelab-agent.sh

# Runs as a real user rather than DynamicUser=yes, which is what the heartbeat
# alone used. The token rollup has to read four private session trees, and a
# per-boot dynamic UID cannot open them. Loosening the
# permissions to suit the agent would expose every transcript to every account
# on the box. Change this to whoever runs the CLIs here.
User=leodeng
Group=leodeng

# Where tokens.py remembers the last rollup it sent, so an unchanged one isn't
# re-pushed every minute. systemd creates it and exports STATE_DIRECTORY.
StateDirectory=homelab-status
# tiktoken caches the o200k_base vocabulary after installation. A persistent,
# service-owned cache avoids downloading it into PrivateTmp on every run.
CacheDirectory=homelab-status
Environment=TIKTOKEN_CACHE_DIR=/var/cache/homelab-status/tiktoken
Environment=PYTHONPATH=/usr/local/lib/homelab-tokens

# Point the collector at all transcript trees explicitly instead of letting it
# derive ~ from $HOME — under ProtectHome=tmpfs the home directory is an empty
# tmpfs, and only the paths bound below are really there.
Environment=CLAUDE_PROJECTS_DIR=/home/leodeng/.claude/projects
Environment=CODEX_SESSIONS_DIR=/home/leodeng/.codex/sessions
Environment=COPILOT_SESSIONS_DIR=/home/leodeng/.copilot/session-state
Environment=COPILOT_VSCODE_WORKSPACES_DIR=/home/leodeng/.vscode-server/data/User/workspaceStorage
Environment=COPILOT_VSCODE_MODEL=copilot-claude-sonnet-4-6-estimate

# The agent reads /proc, /sys, the transcripts, and talks to one host. It has
# no business doing anything else, so it isn't allowed to.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# tmpfs rather than ProtectHome=yes: the home directory is replaced with an
# empty one, then exactly four paths are bound back in read-only. The agent can
# read the transcripts and nothing else under /home — not SSH keys, not
# .dev.vars, not the rest of ~/.claude (which holds OAuth credentials).
ProtectHome=tmpfs
BindReadOnlyPaths=-/home/leodeng/.claude/projects
BindReadOnlyPaths=-/home/leodeng/.codex/sessions
BindReadOnlyPaths=-/home/leodeng/.copilot/session-state
BindReadOnlyPaths=-/home/leodeng/.vscode-server/data/User/workspaceStorage
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_UNIX belongs here even though the agent only talks TCP. Name resolution
# runs the whole nsswitch `hosts:` chain, and the usual Ubuntu chain includes
# mdns4_minimal (Avahi) and mymachines (systemd-machined) — both Unix sockets,
# both consulted before plain `dns`. Drop AF_UNIX and lookups fail or stall
# before they ever reach a nameserver.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
SystemCallFilter=@system-service
CapabilityBoundingSet=
